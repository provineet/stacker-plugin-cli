{
	"name": "vineet/{{textDomain}}",
	"description": "{{description}}",
	"type": "project",
	"license": "{{license}}",
	"autoload": {
		"psr-4": {
			"{{constantPrefix}}\\": "inc/"
		}
	},
	"authors": [
		{
			"name": "{{authorName}}",
			"email": "vineet@blogohblog.com"
		}
	],
	"require": {
		"php": ">={{reqPHP}}"
	},
	"require-dev": {
		"wp-coding-standards/wpcs": "^3.3",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.1",
		"php-stubs/wordpress-stubs": "^7.0",
		"phpunit/phpunit": "^9.6",
		"roots/wordpress": "^7.0",
		"wp-phpunit/wp-phpunit": "^7.0",
		"yoast/phpunit-polyfills": "^3.1",
		"phpcompatibility/phpcompatibility-wp": "*",
		"php-stubs/generator": "*"
	},
	"suggest": {
		"php-stubs/woocommerce-stubs": "Add WooCommerce type stubs when building a WooCommerce extension (note: pin a release compatible with your php-stubs/wordpress-stubs version)."
	},
	"config": {
		"platform": {
			"php": "{{reqPHP}}"
		},
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"roots/wordpress-core-installer": true
		}
	},
	"scripts": {
		"test": "phpunit",
		"post-update-cmd": "./vendor/bin/generate-stubs ./vendor/wp-phpunit/wp-phpunit --out=./vendor/php-stubs/wp-phpunit/wp-phpunit.php",
		"phpcs": "vendor/bin/phpcs",
		"phpcbf": "vendor/bin/phpcbf"
	}
}