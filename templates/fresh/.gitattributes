# Normalize line endings so Windows checkouts don't ship CRLF into the
# Linux Docker container (CRLF in PHP .ini directives, shell scripts, and
# SQL init files breaks them silently).
* text=auto eol=lf

# Files executed/parsed inside the container — must stay LF on every OS.
*.php       text eol=lf
*.ini       text eol=lf
*.sh        text eol=lf
*.sql       text eol=lf
*.js        text eol=lf
*.json      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
Dockerfile  text eol=lf

# Binary assets — never touch.
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.eot       binary
*.zip       binary
