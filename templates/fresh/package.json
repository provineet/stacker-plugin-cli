{
	"name": "{{textDomain}}",
	"version": "{{version}}",
	"description": "{{description}}",
	"main": "index.js",
	"files": [
		"{{pluginFileName}}.php",
		"index.php",
		"inc",
		"blocks",
		"assets",
		"vendor"
	],
	"scripts": {
		"build:blocks": "cross-env WP_BLOCKS_MANIFEST=true WP_EXPERIMENTAL_MODULES=true wp-scripts build --webpack-src-dir=./src/blocks --output-path=./blocks",
		"build:assets": "wp-scripts build --config webpack.assets.js",
		"build": "npm run clean:build && concurrently \"npm:build:blocks\" \"npm:build:assets\"",
		"start:blocks": "cross-env WP_BLOCKS_MANIFEST=true WP_EXPERIMENTAL_MODULES=true wp-scripts start --webpack-src-dir=./src/blocks --output-path=./blocks",
		"start:assets": "wp-scripts start --config webpack.assets.js",
		"watch:sync": "browser-sync start --config bs-config.js",
		"dev": "docker-compose up -d --build && npm run start",
		"start": "npm run clean:build && concurrently \"npm:start:blocks\" \"npm:start:assets\" \"npm:watch:sync\"",
		"format": "wp-scripts format \"src/**/*.{js,jsx}\" && wp-scripts lint-style \"src/**/*.scss\" --fix",
		"lint:css": "wp-scripts lint-style \"src/**/*.scss\"",
		"lint:js": "wp-scripts lint-js",
		"plugin-zip": "wp-scripts plugin-zip",
		"packages-update": "wp-scripts packages-update",
		"prepare": "husky",
		"clean:build": "rimraf blocks assets",
		"clean:dist": "rimraf dist dev-dist *.zip",
		"clean": "npm run clean:build && npm run clean:dist",
		"dist": "npm run build && composer install --no-dev -o && npm run plugin-zip && composer install",
		"devdist": "node bin/make-dev-archive.js"
	},
	"keywords": [
		"WordPress Plugin",
		"{{name}}"
	],
	"author": "{{authorName}}",
	"license": "{{license}}",
	"prettier": "@wordpress/prettier-config",
	"stylelint": {
		"extends": "@wordpress/stylelint-config/scss"
	},
	"lint-staged": {
		"*.js": [
			"wp-scripts lint-js",
			"wp-scripts format"
		],
		"*.scss": "npx stylelint --fix",
		"*.php": "composer run phpcs"
	},
	"overrides": {
		"glob": "$glob",
		"uuid": "^11.1.0",
		"source-map-loader": "^5.0.0",
		"webpack-dev-server": "^5.2.4"
	},
	"devDependencies": {
		"@wordpress/eslint-plugin": "^25.3.0",
		"@wordpress/prettier-config": "^4.47.0",
		"@wordpress/scripts": "^32.3.0",
		"@wordpress/stylelint-config": "^23.39.0",
		"browser-sync": "^3.0.4",
		"concurrently": "^10.0.0",
		"cross-env": "^10.1.0",
		"glob": "^13.0.6",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.5",
		"prettier": "npm:wp-prettier@^3.0.3",
		"rimraf": "^6.1.3",
		"stylelint": "^16.26.1",
		"wp-prettier": "^3.0.3"
	},
	"dependencies": {
		"@wordpress/api-fetch": "^7.47.0",
		"@wordpress/block-editor": "^15.20.0",
		"@wordpress/blocks": "^15.20.0",
		"@wordpress/components": "^34.0.0",
		"@wordpress/compose": "^8.0.0",
		"@wordpress/dom-ready": "^4.47.0",
		"@wordpress/element": "^7.0.0",
		"@wordpress/i18n": "^6.20.0",
		"@wordpress/interactivity": "^6.47.0",
		"classnames": "^2.5.1"
	}
}
